
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= companyName %> | Professional Cleaning Services</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- AOS Animations -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<!-- NAVIGATION -->
<nav class="navbar navbar-expand-lg fixed-top custom-navbar">
    <div class="container">

        <a class="navbar-brand" href="#home">
            <i class="bi bi-stars brand-icon"></i>
            <%= companyName %>
        </a>

        <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNav"
            aria-controls="mainNav"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav mx-auto gap-lg-4">
                <li class="nav-item">
                    <a class="nav-link" href="#home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#services">Our Services</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#about">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact Us</a>
                </li>
            </ul>

            <a href="#contact" class="btn btn-green rounded-pill px-4">
                Get a Quote <i class="bi bi-arrow-up-right ms-1"></i>
            </a>
        </div>
    </div>
</nav>


<!-- HERO SECTION -->
<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-6" data-aos="fade-right">
                <span class="section-tag">
                    <i class="bi bi-check-circle-fill"></i>
                    Professional Cleaning Solutions
                </span>

                <h1 class="hero-title mt-4">
                    A Cleaner Space.
                    <span>A Healthier Life.</span>
                </h1>

                <p class="hero-description mt-4">
                    Experience exceptional cleaning services tailored
                    to your home, office and commercial spaces.
                    We deliver freshness, comfort and peace of mind.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#contact" class="btn btn-green btn-lg rounded-pill px-4">
                        Book Our Services
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <a href="#services" class="btn btn-outline-green btn-lg rounded-pill px-4">
                        Explore Services
                    </a>
                </div>

                <div class="hero-stats d-flex flex-wrap gap-4 mt-5">
                    <div>
                        <h3>100%</h3>
                        <small>Commitment to Quality</small>
                    </div>
                    <div>
                        <h3><i class="bi bi-shield-check"></i></h3>
                        <small>Professional Care</small>
                    </div>
                    <div>
                        <h3><i class="bi bi-stars"></i></h3>
                        <small>Fresh Results</small>
                    </div>
                </div>
            </div>


            <!-- //images -->
            <div class="col-lg-6" data-aos="zoom-in" data-aos-delay="200">
                <div class="hero-image-wrapper">
                    <img src="/images/image1.jpg"
                         alt="Professional cleaning team at work"
                         class="img-fluid hero-image">

                    <div class="floating-card">
                        <div class="floating-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <div>
                            <strong>Quality You Can Trust</strong>
                            <small>Clean spaces, happy faces.</small>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- SERVICES SECTION -->
<section id="services" class="section-padding">
    <div class="container">

        <div class="text-center section-heading" data-aos="fade-up">
            <span class="section-tag">WHAT WE DO</span>
            <h2>Our Professional <span>Cleaning Services</span></h2>
            <p>
                Comprehensive cleaning solutions designed to meet
                your everyday needs.
            </p>
        </div>

        <div class="row g-4 mt-4">

            <% const services = [
                {
                    icon: "bi-house-heart",
                    title: "Residential Cleaning",
                    description: "Keep your home spotless, comfortable and welcoming with our reliable domestic cleaning services."
                },
                {
                    icon: "bi-buildings",
                    title: "Office Cleaning",
                    description: "Maintain a clean, hygienic and productive working environment for your employees and visitors."
                },
                {
                    icon: "bi-droplet",
                    title: "Deep Cleaning",
                    description: "Thorough cleaning of hard-to-reach areas, surfaces and spaces requiring extra attention."
                },
                {
                    icon: "bi-grid-3x3-gap",
                    title: "Carpet & Upholstery",
                    description: "Professional care for carpets, sofas and upholstery to help restore freshness and appearance."
                },
                {
                    icon: "bi-window",
                    title: "Window Cleaning",
                    description: "Detailed cleaning of glass surfaces and windows for a brighter, clearer finish."
                },
                {
                    icon: "bi-brush",
                    title: "Post-Construction Cleaning",
                    description: "Removal of dust and debris after renovations and construction to prepare your space for use."
                }
            ]; %>

            <% services.forEach((service, index) => { %>
                <div class="col-md-6 col-lg-4"
                     data-aos="fade-up"
                     data-aos-delay="<%= (index % 3) * 100 %>">

                    <div class="service-card h-100">
                        <div class="service-icon">
                            <i class="bi <%= service.icon %>"></i>
                        </div>

                        <h4><%= service.title %></h4>
                        <p><%= service.description %></p>

                        <a href="#contact" class="service-link">
                            Request Service
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            <% }); %>

        </div>
    </div>
</section>


<!-- ABOUT SECTION -->
<section id="about" class="section-padding about-section">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-6" data-aos="fade-right">
                <div class="about-image">
                    <img src="/images/image2.jpg"
                         alt="Cleaning professional"
                         class="img-fluid">
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <span class="section-tag">ABOUT OUR COMPANY</span>

                <h2 class="section-title mt-3">
                    We Bring Freshness Into
                    <span>Every Space.</span>
                </h2>

                <p class="mt-4">
                    At <%= companyName %>, we believe that a clean
                    environment creates a healthier and more comfortable
                    place to live and work.
                </p>

                <p>
                    Our goal is to provide dependable cleaning solutions
                    with attention to detail, professionalism and
                    excellent customer service.
                </p>

                <div class="row g-3 mt-3">
                    <div class="col-sm-6">
                        <div class="feature-item">
                            <i class="bi bi-check-circle-fill"></i>
                            Trained Cleaning Team
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="feature-item">
                            <i class="bi bi-check-circle-fill"></i>
                            Attention to Detail
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="feature-item">
                            <i class="bi bi-check-circle-fill"></i>
                            Flexible Scheduling
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="feature-item">
                            <i class="bi bi-check-circle-fill"></i>
                            Customer-Focused Service
                        </div>
                    </div>
                </div>

                <a href="#contact" class="btn btn-green rounded-pill px-4 py-3 mt-4">
                    Work With Us
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>

        </div>
    </div>
</section>


<!-- WHY CHOOSE US -->
<section class="section-padding">
    <div class="container">

        <div class="text-center section-heading" data-aos="fade-up">
            <span class="section-tag">OUR ADVANTAGE</span>
            <h2>Why Choose <span>Our Company?</span></h2>
            <p>
                We are committed to making every cleaning experience
                simple, dependable and worthwhile.
            </p>
        </div>

        <div class="row g-4 mt-4">
            <% const benefits = [
                ["bi-people", "Dedicated Team", "A committed team focused on delivering quality cleaning services."],
                ["bi-clock-history", "Flexible Scheduling", "Convenient cleaning arrangements suited to your schedule."],
                ["bi-shield-check", "Reliable Service", "A professional approach with care for your property."],
                ["bi-heart", "Customer Satisfaction", "Your comfort and satisfaction remain our priority."]
            ]; %>

            <% benefits.forEach((item, index) => { %>
                <div class="col-md-6 col-lg-3"
                     data-aos="fade-up"
                     data-aos-delay="<%= index * 100 %>">

                    <div class="benefit-card text-center h-100">
                        <div class="benefit-icon">
                            <i class="bi <%= item[0] %>"></i>
                        </div>
                        <h5><%= item[1] %></h5>
                        <p><%= item[2] %></p>
                    </div>

                </div>
            <% }); %>
        </div>

    </div>
</section>


<!-- CLEANING PROCESS -->
<section class="section-padding process-section">
    <div class="container">

        <div class="text-center section-heading" data-aos="fade-up">
            <span class="section-tag">HOW IT WORKS</span>
            <h2>Our Simple <span>Cleaning Process</span></h2>
            <p>Getting your space professionally cleaned is easy.</p>
        </div>

        <div class="row g-4 mt-4">
            <% const steps = [
                ["01", "Contact Us", "Reach out through our website or phone and tell us what you need."],
                ["02", "Get a Quote", "We review your cleaning requirements and provide a suitable quotation."],
                ["03", "Schedule Cleaning", "Choose a convenient date and time for your cleaning service."],
                ["04", "Enjoy Your Space", "Our team handles the cleaning so you can enjoy a fresh environment."]
            ]; %>

            <% steps.forEach((step, index) => { %>
                <div class="col-md-6 col-lg-3" data-aos="fade-up"
                     data-aos-delay="<%= index * 100 %>">
                    <div class="process-card">
                        <div class="step-number"><%= step[0] %></div>
                        <h5><%= step[1] %></h5>
                        <p><%= step[2] %></p>
                    </div>
                </div>
            <% }); %>
        </div>

    </div>
</section>


<!-- CURRENT CLIENTS -->
<section id="clients" class="section-padding clients-section">
    <div class="container text-center">

        <div class="section-heading" data-aos="fade-up">
            <span class="section-tag">OUR CLIENTS</span>
            <h2>Companies That <span>Work With Us</span></h2>
            <p>
                This section showcases the organizations and businesses
                we serve.
            </p>
        </div>

        <!-- Replace these placeholders with actual client logos -->
        <div class="row g-4 justify-content-center mt-4">

            <% for(let i = 1; i <= 4; i++) { %>
                <div class="col-6 col-md-3" data-aos="zoom-in">
                    <div class="client-logo">
                        <i class="bi bi-building"></i>
                        <span>Client Logo <%= i %></span>
                    </div>
                </div>
            <% } %>

        </div>

    </div>
</section>


<!-- TESTIMONIALS -->
<section class="section-padding testimonials-section">
    <div class="container">

        <div class="text-center section-heading" data-aos="fade-up">
            <span class="section-tag">TESTIMONIALS</span>
            <h2>What Our <span>Clients Say</span></h2>
            <p>Real experiences from the people we serve.</p>
        </div>

        <!-- Sample placeholders: replace with verified customer feedback -->
        <div class="row g-4 mt-4">

            <% const testimonials = [
                {
                    quote: "Insert a verified customer review about your residential cleaning services here.",
                    name: "Customer Name",
                    role: "Residential Client"
                },
                {
                    quote: "Insert feedback from one of your commercial or office cleaning clients here.",
                    name: "Customer Name",
                    role: "Corporate Client"
                },
                {
                    quote: "Insert a genuine testimonial highlighting your team's professionalism and service quality.",
                    name: "Customer Name",
                    role: "Cleaning Client"
                }
            ]; %>

            <% testimonials.forEach((review, index) => { %>
                <div class="col-md-6 col-lg-4"
                     data-aos="fade-up"
                     data-aos-delay="<%= index * 100 %>">

                    <div class="testimonial-card h-100">
                        <i class="bi bi-quote quote-icon"></i>

                        <p>"<%= review.quote %>"</p>

                        <div class="testimonial-author">
                            <div class="author-avatar">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <strong><%= review.name %></strong>
                                <small><%= review.role %></small>
                            </div>
                        </div>
                    </div>

                </div>
            <% }); %>

        </div>

    </div>
</section>


<!-- CALL TO ACTION -->
<section class="cta-section">
    <div class="container text-center" data-aos="zoom-in">

        <span class="section-tag">LET'S GET STARTED</span>

        <h2 class="mt-3">
            Ready for a Cleaner, Fresher Space?
        </h2>

        <p>
            Contact us today and let our team take care of your
            cleaning needs.
        </p>

        <a href="#contact" class="btn btn-light rounded-pill px-5 py-3 mt-3">
            Request a Free Quote
            <i class="bi bi-arrow-right ms-2"></i>
        </a>

    </div>
</section>


<!-- CONTACT SECTION -->
<section id="contact" class="section-padding">
    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-5" data-aos="fade-right">
                <span class="section-tag">CONTACT US</span>

                <h2 class="section-title mt-3">
                    Let's Talk About Your
                    <span>Cleaning Needs.</span>
                </h2>

                <p class="mt-3">
                    Have a question or need a quotation?
                    Fill out the form and our team will get in touch.
                </p>

                <div class="contact-detail mt-4">
                    <i class="bi bi-telephone"></i>
                    <div>
                        <strong>Phone Number</strong>
                        <p>+254 741 395 446</p>
                    </div>
                </div>

                <div class="contact-detail">
                    <i class="bi bi-envelope"></i>
                    <div>
                        <strong>Email Address</strong>
                        <p>customercare@diamondpolish.co.ke</p>
                        <p>info@diamondpolish.co.ke</p>
                    </div>
                </div>

                <div class="contact-detail">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <strong>Our Location</strong>
                        <p>Budalangi, Njiru Town <br>Off Kangundo Rd.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7" data-aos="fade-left">
                <div class="contact-form-card">

                    <h4 class="mb-4">Request a Cleaning Service</h4>

                    <% if (typeof contactStatus !== 'undefined' && contactStatus === 'success') { %>
                        <div class="alert alert-success">
                            Your enquiry has been received.
                        </div>
                    <% } %>

                    <form action="/contact" method="POST" id="servicerequest">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label">Full Name</label>
                                <input type="text" id="name" name="name"
                                    class="form-control" placeholder="Your name" required>
                            </div>

                            <div class="col-md-6">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" id="email" name="email"
                                    class="form-control" placeholder="Your email" required>
                            </div>

                            <div class="col-md-6">
                                <label for="phone" class="form-label">Phone Number</label>
                                <input type="tel" id="phone" name="phone"
                                    class="form-control" placeholder="Your phone" required>
                            </div>

                            <div class="col-md-6">
                                <label for="service" class="form-label">Service Required</label>
                                <select id="service" name="service"
                                    class="form-select" required>
                                    <option value="">Select Service</option>
                                    <% services.forEach(service => { %>
                                        <option value="<%= service.title %>">
                                            <%= service.title %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="col-12">
                                <label for="message" class="form-label">Your Message</label>
                                <textarea id="message" name="message"
                                    class="form-control" rows="5"
                                    placeholder="Tell us about your cleaning requirements..."
                                    required></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit"
                                    class="btn btn-green w-100 py-3 rounded-pill">
                                    Send Enquiry
                                    <i class="bi bi-send ms-2"></i>
                                </button>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</section>


 <a
                href="https://wa.me/message/DK4TPHG2O45XH1"
                target="_blank"
                rel="noopener noreferrer"
                class="position-fixed bottom-0 start-0 m-4 btn btn-success rounded-circle shadow d-flex align-items-center justify-content-center"
                style="width: 60px; height: 60px; z-index: 1050;"
                aria-label="Join our WhatsApp group"
              >
                <i class="bi bi-whatsapp fs-2"></i>
              </a>

<!-- FOOTER -->
<footer class="footer">
    <div class="container">

        <div class="row gy-5">

            <!-- Company details -->
            <div class="col-lg-4 col-md-6">
                <h4 class="footer-brand">
                    <i class="bi bi-stars"></i>
                    <%= companyName %>
                </h4>

                <p class="footer-description mt-3">
                    Your trusted cleaning partner, dedicated to
                    creating clean, healthy and comfortable spaces.
                    Insert your official company description here.
                </p>

                <div class="social-links d-flex gap-2 mt-4">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>

            <!-- Quick links -->
            <div class="col-lg-2 col-md-6">
                <h5>Quick Links</h5>

                <ul class="footer-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About Us</a></li>
                    <li><a href="#services">Our Services</a></li>
                    <li><a href="#clients">Our Clients</a></li>
                    <li><a href="#contact">Contact Us</a></li>
                </ul>
            </div>

            <!-- Services -->
            <div class="col-lg-3 col-md-6">
                <h5>Our Services</h5>

                <ul class="footer-links">
                    <% services.slice(0, 5).forEach(service => { %>
                        <li>
                            <a href="#services"><%= service.title %></a>
                        </li>
                    <% }); %>
                </ul>
            </div>

            <!-- Contact -->
            <div class="col-lg-3 col-md-6">
                <h5>Get In Touch</h5>

                <ul class="footer-links footer-contact">
                    <li>
                        <i class="bi bi-geo-alt"></i>
                        Budalangi, Njiru Town <br>Off Kangundo Rd.
                    </li>
                    <li>
                        <i class="bi bi-telephone"></i>
                        +254 741 395 446
                    </li>
                    <li>
                        <i class="bi bi-envelope"></i>
                        info@diamondpolish.co.ke
                    </li>
                    <li>
                        <i class="bi bi-envelope"></i>
                        customercare@diamondpolish.co.ke
                    </li>
                    <li>
                        <i class="bi bi-clock"></i>
                        SUN - FRI 8AM - 5:30PM
                    </li>
                </ul>
            </div>

        </div>

        <hr class="footer-divider">

        <div class="row align-items-center gy-3">
            <div class="col-md-6 text-center text-md-start">
                <small>
                    &copy; <%= year %> <%= companyName %>.
                    All Rights Reserved.
                </small>
            </div>

            <div class="col-md-6 text-center text-md-end">
                <small>
                    <a href="#">Privacy Policy</a>
                    <span class="mx-2">|</span>
                    <a href="#">Terms & Conditions</a>
                </small>
            </div>
        </div>

    </div>
</footer>


<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- AOS Animation JS -->
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<!-- Custom JS -->
<script src="/js/main.js"></script>
<script>
    const requestServiceForm = document.getElementById("servicerequest")
    requestServiceForm.addEventListener("submit", async (e)=>{
            e.preventDefault()

            const formData = new FormData(requestServiceForm)
            const payLoad = Object.fromEntries(formData.entries())
            const res = await fetch("/contact",{
                body: JSON.stringify(payLoad),
                method:"POST",
                  headers:{
                    "content-type":"application/json"
                }
            })

            const response = await res.json();
    })
</script>
</body>
</html>
